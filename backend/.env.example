# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# Get your API key at: https://cloud.ibm.com/iam/apikeys
# Create a project at: https://dataplatform.cloud.ibm.com
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://ca-tor.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ── Google Gemini (fallback AI) ───────────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── API-Sports (player search) ────────────────────────────────────────────────
# Get your key at: https://rapidapi.com/api-sports/api/api-football
# Free tier: 100 requests/day
API_SPORTS_KEY=your_api_sports_key_here
