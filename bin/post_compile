#!/usr/bin/env bash
# Heroku passes BUILD_DIR as $1.
set -euo pipefail

BUILD_DIR=${1:-/app}
PIP="$BUILD_DIR/.heroku/python/bin/pip"

echo "-----> Installing CPU-only PyTorch + CV deps"

$PIP install torch torchvision \
  --index-url https://download.pytorch.org/whl/cpu \
  --quiet

$PIP install scikit-learn ultralytics supervision --quiet

# ultralytics pulls in opencv-python (needs libGL) — override with headless version
$PIP install opencv-python-headless --force-reinstall --quiet

# sports library for pitch config/homography/annotators — no-deps skips
# the heavy transformers/umap stack (TeamClassifier already optional in cv_pipeline)
$PIP install "git+https://github.com/roboflow/sports.git" --no-deps --quiet

echo "-----> CV deps installed OK"
